{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atonacht",
  "version": "0.2.0",
  "identifier": "app.atonacht.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atonacht",
        "width": 1280,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "atonacht"
          ],
          "host": "capture",
          "appLink": false
        },
        {
          "scheme": [
            "atonacht"
          ],
          "host": "tasks",
          "appLink": false
        },
        {
          "scheme": [
            "atonacht"
          ],
          "host": "home",
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "atonacht"
        ]
      }
    }
  }
}